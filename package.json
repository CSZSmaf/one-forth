{
  "name": "one-forth",
  "version": "0.1.0",
  "private": true,
  "description": "One Forth interactive scientific knowledge platform",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@one-forth/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && pnpm test:scripts",
    "test:scripts": "tsx --test scripts/audit-content.test.ts scripts/audit-public-content.test.ts scripts/content-style.test.ts scripts/content-similarity.test.ts scripts/lib/control-characters.test.ts scripts/lib/tool-index.test.ts scripts/redirects/artifacts.test.ts scripts/validate-publication.test.ts scripts/validate-anchors.test.ts scripts/migrations/v1-to-v2.test.ts scripts/migrations/v2-to-v3.test.ts scripts/migrations/semantic-anchors.test.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:public-content": "tsx scripts/audit-public-content.ts",
    "test:a11y": "pnpm --filter @one-forth/web test:a11y",
    "test:e2e": "pnpm --filter @one-forth/web test:e2e",
    "test:scientific": "pnpm --filter @one-forth/web test:scientific",
    "test:visual": "pnpm --filter @one-forth/web test:visual",
    "capture:revision": "pnpm --filter @one-forth/web capture:revision",
    "capture:round-3": "pnpm --filter @one-forth/web capture:round-3",
    "visual:diff": "python scripts/visual-diff.py",
    "test:architecture": "tsx scripts/test-architecture.ts",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:math": "pnpm --filter @one-forth/web validate:math",
    "validate:publication": "tsx scripts/validate-publication.ts",
    "validate:curriculum": "tsx scripts/validate-curriculum.ts",
    "validate:anchors": "tsx scripts/validate-anchors.ts",
    "report:curriculum": "tsx scripts/report-curriculum.ts",
    "report:round5-final": "tsx scripts/report-round5-final.ts",
    "generate:curriculum": "tsx scripts/generate-curriculum.ts",
    "generate:redirects": "tsx scripts/redirects/generate.ts",
    "validate:redirects": "tsx scripts/validate-redirects.ts",
    "audit:navigation": "tsx scripts/audit-navigation.ts",
    "lint:content-style": "tsx scripts/content-style.ts",
    "test:content-style": "tsx --test scripts/content-style.test.ts",
    "audit:content-similarity": "tsx scripts/content-similarity.ts",
    "test:content-similarity": "tsx --test scripts/content-similarity.test.ts",
    "check:links": "tsx scripts/check-links.ts",
    "verify:indexability": "tsx scripts/verify-indexability.ts",
    "migrate:content": "tsx scripts/migrate-content.ts",
    "new:topic": "tsx scripts/new-topic.ts",
    "generate:content": "tsx scripts/generate-content.ts",
    "analyze": "pnpm --filter @one-forth/web analyze && tsx scripts/analyze-bundle.ts",
    "lighthouse": "tsx scripts/run-lighthouse.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:registry && pnpm validate:content && pnpm validate:math && pnpm validate:publication && pnpm audit:public-content && pnpm lint:content-style && pnpm audit:content-similarity && pnpm check:links && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "lighthouse": "13.5.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "turbo": "2.9.14",
    "typescript": "5.9.3"
  },
  "type": "module"
}
