{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "one-forth-edge-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ORIGIN_URL": "https://origin.example.org",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
