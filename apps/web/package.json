{
  "name": "@one-forth/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "pnpm --dir ../.. generate:content",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "pnpm --dir ../.. generate:content && tsx scripts/validate-authored-math.ts",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && tsx scripts/prepare-public-assets.ts && tsx scripts/check-worker-size.ts && tsx scripts/check-public-client-assets.ts",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scientific": "vitest run features/visualizations/science tests/math-experiment-models.test.ts tests/math-experiment-components.test.tsx",
    "test:a11y": "playwright test tests/a11y.spec.ts --project=chromium",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test visual.spec.ts --project=visual-390 --project=visual-768 --project=visual-1440",
    "capture:revision": "tsx scripts/capture-revision-round-2.ts",
    "capture:round-3": "tsx scripts/capture-revision-round-3.ts",
    "capture:round-5-production": "tsx scripts/capture-round-5-production.ts",
    "check:worker-size": "tsx scripts/check-worker-size.ts",
    "check:public-client-assets": "tsx scripts/check-public-client-assets.ts",
    "validate:math": "tsx scripts/validate-authored-math.ts",
    "analyze": "cross-env ANALYZE=true vinext build",
    "wrangler:types": "wrangler types ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@one-forth/config": "workspace:*",
    "@one-forth/content": "workspace:*",
    "@one-forth/knowledge-graph": "workspace:*",
    "@one-forth/math-core": "workspace:*",
    "@one-forth/numerical": "workspace:*",
    "@one-forth/physics": "workspace:*",
    "@one-forth/registry": "workspace:*",
    "@one-forth/search": "workspace:*",
    "@one-forth/simulation-runtime": "workspace:*",
    "@one-forth/ui": "workspace:*",
    "@one-forth/visualization": "workspace:*",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "clsx": "2.1.1",
    "katex": "0.18.2",
    "lucide-react": "0.468.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.49.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "wrangler": "4.116.0"
  }
}
